# Copy to backend/.env and adjust.

# --- Database (SQLAlchemy URL) ---
# Local development (default):
DATABASE_URL=sqlite:///./alaala.db
# Firebase Data Connect's Cloud SQL for PostgreSQL instance (via Cloud SQL Auth Proxy on localhost:5432):
# DATABASE_URL=postgresql+psycopg://alaala_app:YOUR_PASSWORD@127.0.0.1:5432/fdcdb

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Prolog ---
SWIPL_PATH=swipl
PROLOG_TIMEOUT_S=10

# --- Dates for release rules ---
APP_TIMEZONE=Asia/Manila

# --- Language model ---
# offline   : built-in extractive agent, no network or key needed
# anthropic : Anthropic Messages API (tool use)
# openai    : any OpenAI-compatible Chat Completions endpoint (set LLM_BASE_URL for others)
LLM_PROVIDER=offline
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOOL_ROUNDS=6

# --- Email notices to beneficiaries after the death trigger ---
# Leave SMTP_HOST empty to keep notices in the outbox (Settings) without sending.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MMK <no-reply@example.com>
# Or send email through the Brevo HTTP API instead of SMTP (needed on hosts that block SMTP, e.g. Render free).
BREVO_API_KEY=
SMTP_STARTTLS=true

# --- Email verification (development only) ---
# When SMTP is not set up, show the 6-digit verification code on screen so you can still sign up
# locally. NEVER enable this on a public server.
DEV_SHOW_VERIFICATION_CODE=true
